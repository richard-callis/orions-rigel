// Prisma schema for the technical training platform.
// Course/lesson content itself lives in src/content/ as MDX files —
// this schema only models accounts, per-user progress, and live-session
// state (instructor-driven slide position, pop quizzes).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  progress      LessonProgress[]
  savedQueries  SavedQuery[]
  quizResponses QuizResponse[]
}

// One row per (user, lesson) once the user marks it complete.
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  courseSlug  String
  moduleSlug  String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug, moduleSlug])
  @@index([userId])
}

// A snippet a user saved from the practice console (SQL or, for a
// yaml-sandbox course, a Kubernetes manifest) to reload later.
model SavedQuery {
  id         String   @id @default(cuid())
  userId     String
  courseSlug String
  title      String
  content    String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, courseSlug])
}

// An instructor "driving" a module's Presentation-mode slides live.
// Non-instructor viewers polling this can't navigate past currentSlide —
// see SlideDeck. Only one row should be isActive per (courseSlug,
// moduleSlug) at a time; starting a new session should close any prior one.
model LiveSession {
  id           String    @id @default(cuid())
  courseSlug   String
  moduleSlug   String
  instructorId String
  currentSlide Int       @default(0)
  isActive     Boolean   @default(true)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([courseSlug, moduleSlug, isActive])
}

// One activation of a <Quiz id="..."> authored in a module's MDX content.
// The question/options/answer live in the content itself, not here — this
// just tracks that it's "live" right now and collects responses.
model ActiveQuiz {
  id          String    @id @default(cuid())
  courseSlug  String
  moduleSlug  String
  quizKey     String
  activatedBy String
  activatedAt DateTime  @default(now())
  closedAt    DateTime?

  responses QuizResponse[]

  @@index([courseSlug, moduleSlug, quizKey])
}

model QuizResponse {
  id            String   @id @default(cuid())
  activeQuizId  String
  userId        String
  selectedIndex Int
  answeredAt    DateTime @default(now())

  activeQuiz ActiveQuiz @relation(fields: [activeQuizId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activeQuizId, userId])
}

// AI-drafted courses (see /admin/create-training), stored in the DB rather
// than as files in src/content/ — this coexists with the file-based
// courses rather than replacing them. getCoursesAsync()/getCourseAsync()/
// etc. in src/lib/content.ts merge both sources for every page that lists
// or renders a course; hand-authored file-based courses are untouched.
// createdById is a plain string (no relation) — matches LiveSession/
// ActiveQuiz's pattern, so deleting the creating user's account never
// cascades away course content.
model GeneratedCourse {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  tagline     String?
  sandboxType String   @default("sql")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules GeneratedModule[]
}

model GeneratedModule {
  id          String   @id @default(cuid())
  courseId    String
  slug        String
  order       Int
  title       String
  description String
  level       String
  duration    String?
  content     String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course GeneratedCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, slug])
  @@unique([courseId, order])
}
