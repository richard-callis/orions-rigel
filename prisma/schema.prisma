// Prisma schema for the technical training platform.
// Course/lesson content itself lives in src/content/ as MDX files —
// this schema only models accounts and per-user progress.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  progress LessonProgress[]
}

// One row per (user, lesson) once the user marks it complete.
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  courseSlug  String
  moduleSlug  String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug, moduleSlug])
  @@index([userId])
}
