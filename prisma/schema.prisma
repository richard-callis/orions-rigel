// Prisma schema for the technical training platform.
// Course/lesson content itself lives in src/content/ as MDX files —
// this schema only models accounts, per-user progress, and live-session
// state (instructor-driven slide position, pop quizzes).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  progress             LessonProgress[]
  reviewSchedules      ReviewSchedule[]
  savedQueries         SavedQuery[]
  quizResponses        QuizResponse[]
  exerciseAttempts     ExerciseAttempt[]
  lessonFeedback       LessonFeedback[]
  challengeSubmissions ChallengeSubmission[]
  liveAttendances      LiveSessionAttendance[]
}

// One row per (user, lesson) once the user marks it complete.
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  courseSlug  String
  moduleSlug  String
  completedAt DateTime @default(now())
  // Set when this completion came from following an instructor's live
  // session through to the end (see LiveSessionAttendance), rather than
  // self-paced study. Distinct credit — surfaced separately in the UI.
  attendedLive Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug, moduleSlug])
  @@index([userId])
}

// A snippet a user saved from the practice console (SQL or, for a
// yaml-sandbox course, a Kubernetes manifest) to reload later.
model SavedQuery {
  id         String   @id @default(cuid())
  userId     String
  courseSlug String
  title      String
  content    String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, courseSlug])
}

// An instructor "driving" a module's Presentation-mode slides live.
// Non-instructor viewers polling this can't navigate past currentSlide —
// see SlideDeck. Only one row should be isActive per (courseSlug,
// moduleSlug) at a time; starting a new session should close any prior one.
model LiveSession {
  id            String    @id @default(cuid())
  courseSlug    String
  moduleSlug    String
  instructorId  String
  currentSlide  Int       @default(0)
  isActive      Boolean   @default(true)
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  updatedAt     DateTime  @updatedAt
  // Timeline of slide changes for replay: [{ slideIndex, atMs }], atMs
  // relative to startedAt. Appended to on each currentSlide update.
  sessionEvents Json      @default("[]")
  // Short human-typeable code (e.g. "BREW-42") for students to join by
  // hand, Jackbox-style, in addition to the course-page "Join live" button.
  // Unique only while a session is active — freed up once it ends so codes
  // stay short instead of growing unbounded. Prisma's declarative @@unique
  // can't express "unique WHERE isActive" (it would also forbid two ended
  // sessions from ever sharing a code, which happens constantly once a
  // course has run more than once) — the real constraint is a Postgres
  // partial unique index created by hand in the migration SQL. Uniqueness
  // is additionally enforced at the application layer (see the retry loop
  // in /api/live-sessions POST and /api/live-sessions/[id]/advance).
  roomCode      String

  attendances  LiveSessionAttendance[]
  chatMessages LiveChatMessage[]

  @@index([courseSlug, moduleSlug, isActive])
  @@index([roomCode, isActive])
}

// Tracks who actually followed a specific live session, distinct from the
// module-level LessonProgress row it ultimately produces. Lets us tell "sat
// through the live session" apart from "read it solo afterward" even
// though both end in a completed LessonProgress — and gives an instructor
// a real attendance list per session.
model LiveSessionAttendance {
  id            String   @id @default(cuid())
  liveSessionId String
  userId        String
  joinedAt      DateTime @default(now())
  // Highest slide index this attendee has reached while following along —
  // lets "completed" require having actually reached the final slide,
  // not just having joined at some point and wandered off.
  reachedSlide  Int      @default(0)
  // Bumped on every presence heartbeat while the tab is open in Present
  // Mode — "currently watching" (Twitch-style viewer count) is derived as
  // lastSeenAt within the last ~30s, separate from total attendance which
  // never shrinks once someone has joined.
  lastSeenAt    DateTime @default(now())

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, userId])
  @@index([userId])
}

// A chat message posted during a live session — the running Twitch-style
// feed, distinct from LiveQuestion/LiveQuestionUpvote which is the curated,
// upvoted "ask the instructor" queue. Chat is ephemeral noise by design; Q&A
// is the signal that surfaces above it.
model LiveChatMessage {
  id            String   @id @default(cuid())
  liveSessionId String
  userId        String
  userName      String
  text          String
  createdAt     DateTime @default(now())

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@index([liveSessionId, createdAt])
}

// One activation of a <Quiz id="..."> authored in a module's MDX content.
// The question/options/answer live in the content itself, not here — this
// just tracks that it's "live" right now and collects responses.
model ActiveQuiz {
  id          String    @id @default(cuid())
  courseSlug  String
  moduleSlug  String
  quizKey     String
  activatedBy String
  activatedAt DateTime  @default(now())
  closedAt    DateTime?

  responses QuizResponse[]

  @@index([courseSlug, moduleSlug, quizKey])
}

model QuizResponse {
  id            String   @id @default(cuid())
  activeQuizId  String
  userId        String
  selectedIndex Int
  answeredAt    DateTime @default(now())

  activeQuiz ActiveQuiz @relation(fields: [activeQuizId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activeQuizId, userId])
}

// A record of a student's attempt to solve an exercise (SQL or YAML).
// The exercise definition (prompt, reference query, checks) lives in the
// MDX content itself; this only tracks whether they passed.
model ExerciseAttempt {
  id          String   @id @default(cuid())
  userId      String
  exerciseKey String // synthetic key: ${courseSlug}:${moduleSlug}:${exerciseId}
  passed      Boolean
  attemptedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseKey])
  @@index([userId])
}

// An anonymously-submitted question during a live session.
// userId is plain (NOT a FK) to match the LiveSession/ActiveQuiz pattern —
// ephemeral live-session data shouldn't cascade-delete when users are deleted.
model LiveQuestion {
  id         String   @id @default(cuid())
  courseSlug String
  moduleSlug String
  text       String
  userId     String
  answered   Boolean  @default(false)
  createdAt  DateTime @default(now())

  upvotes LiveQuestionUpvote[]

  @@index([courseSlug, moduleSlug, answered])
}

// User upvotes on a question. Can be deleted when the question is deleted.
model LiveQuestionUpvote {
  id         String @id @default(cuid())
  questionId String
  userId     String

  question LiveQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
}

// Spaced-repetition review schedule for modules.
// When a module is marked complete, a ReviewSchedule row is created/updated
// with an initial review interval. Students can review on a simple SM-2-lite
// algorithm: easy reviews push the interval further, hard reviews reset it shorter.
model ReviewSchedule {
  id             String    @id @default(cuid())
  userId         String
  courseSlug     String
  moduleSlug     String
  dueAt          DateTime
  intervalDays   Int       @default(1)
  reviewCount    Int       @default(0)
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug, moduleSlug])
  @@index([userId, dueAt])
}

// Student feedback on a lesson (1-5 star rating + optional comment).
model LessonFeedback {
  id         String   @id @default(cuid())
  userId     String
  courseSlug String
  moduleSlug String
  rating     Int // 1-5
  comment    String? // Optional feedback text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug, moduleSlug])
  @@index([courseSlug, moduleSlug])
}

// AI-drafted courses (see /admin/create-training), stored in the DB rather
// than as files in src/content/ — this coexists with the file-based
// courses rather than replacing them. getCoursesAsync()/getCourseAsync()/
// etc. in src/lib/content.ts merge both sources for every page that lists
// or renders a course; hand-authored file-based courses are untouched.
// createdById is a plain string (no relation) — matches LiveSession/
// ActiveQuiz's pattern, so deleting the creating user's account never
// cascades away course content.
model GeneratedCourse {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  tagline     String?
  sandboxType String   @default("sql")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules GeneratedModule[]
}

model GeneratedModule {
  id          String   @id @default(cuid())
  courseId    String
  slug        String
  order       Int
  title       String
  description String
  level       String
  duration    String?
  content     String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course GeneratedCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, slug])
  @@unique([courseId, order])
}

// A weekly SQL challenge. AI can draft one (see /admin/challenges/create,
// mirroring AI-assisted training creation), but nothing is visible to
// students until an instructor/admin publishes it, and only one challenge
// is isActive at a time — the admin controls the weekly rotation manually.
//
// Grading is server-side and authoritative (see /api/challenges/submit):
// submitted SQL never runs against the real app database. It's executed in
// an ephemeral sandbox seeded from schemaSql, alongside checkQuery, and the
// two result sets are compared. solutionSql/checkQuery are never sent to
// the client — leaking them would leak the answer.
model WeeklyChallenge {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String // problem statement, Markdown
  difficulty  String // "easy" | "medium" | "hard"
  language    String   @default("sql") // "sql" for now — grading only supports SQL; other languages are tagged for the future but not yet gradeable
  tags        String[] @default([]) // freeform topic tags (e.g. "window-functions", "joins") for browsing/filtering

  // Public — sent to the client so students can freely explore in the
  // practice console before submitting. Same table/column structure as
  // hiddenSchemaSql, different row values.
  schemaSql String

  // Never sent to any client-facing API route — the actual grading run
  // (see grade-sql-challenge.ts) always uses this instead of schemaSql.
  // If grading used the same data students can already see, a submission
  // that just hardcodes the answer's literal values (solve it once by
  // reading the visible rows, then `SELECT 'x', 1 UNION ALL ...` instead
  // of writing a query that actually computes the answer) would pass and
  // even top the leaderboard on speed, since it does no real work.
  // Comparing against different underlying data closes that off: a
  // memorized literal answer is correct for the public dataset's values,
  // not the hidden one's.
  hiddenSchemaSql String

  solutionSql  String // reference solution — lets the author sanity-check checkQuery against it, never shown to students while active
  checkQuery   String // canonical query defining "correct"; compared against the submission's result set
  requireOrder Boolean  @default(false) // if true, row order must match checkQuery's; if false, compared as sets
  weekOf       DateTime // Monday (UTC) this challenge is meant to be active for
  isActive     Boolean  @default(false)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions ChallengeSubmission[]

  @@index([isActive])
  @@index([weekOf])
}

// One row per (user, challenge) — a user's best passing submission, or
// their latest failing one if they haven't passed yet. runtimeMs and
// planCost are measured server-side at grading time, not client-reported,
// so the leaderboard can't be gamed by posting fabricated numbers.
model ChallengeSubmission {
  id           String   @id @default(cuid())
  challengeId  String
  userId       String
  sql          String
  passed       Boolean
  runtimeMs    Int // wall-clock time to execute the submitted query in the sandbox
  planCost     Float? // EXPLAIN's estimated Total Cost — a stand-in for query efficiency, comparable since every submission runs against the same seeded data
  errorMessage String?
  attempts     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  challenge WeeklyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId, passed, runtimeMs])
}
