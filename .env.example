# App database (users, progress). Separate from the in-browser PGlite
# database learners query — see README.md.
DATABASE_URL="postgresql://training_app:training_dev_password@localhost:5432/technical_training?schema=public"

# Auth.js session signing secret. Generate a real one for anything beyond
# local dev:
#   openssl rand -base64 32
AUTH_SECRET="replace-me"

# Optional. Comma-separated emails that become ADMIN on signup. The very
# first account ever created becomes ADMIN automatically either way.
# ADMIN_EMAILS="you@example.com"
